{
  "name": "elva",
  "version": "4.1.2",
  "description": "A multilingual, clean, green, 11ty starter theme",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "npm-run-all clean dev",
    "dev": "eleventy --serve --incremental",
    "build": "npm-run-all clean build:eleventy",
    "build:eleventy": "cross-env ELEVENTY_ENV=production eleventy",
    "build:stage": "npm-run-all clean build:stage:eleventy",
    "build:stage:eleventy": "cross-env ELEVENTY_ENV=staging eleventy",
    "clean": "rimraf dist",
    "cli": "node .cli/index.js",
    "debug": "cross-env DEBUG=Eleventy* npm run dev",
    "benchmark": "cross-env ELEVENTY_ENV=production DEBUG=Eleventy:Benchmark* npm run build",
    "test": "echo \"Error: no test specified\" && exit 1",
    "release-patch": "npm version patch --force && npm publish",
    "release-minor": "npm version minor --force && npm publish",
    "release-major": "npm version major --force && npm publish"
  },
  "bugs": {
    "url": "https://github.com/scottsweb/elva/issues"
  },
  "keywords": [
    "eleventy",
    "11ty",
    "starter",
    "theme",
    "i18n",
    "rss",
    "markdown",
    "sitemaps",
    "CSS",
    "alpine"
  ],
  "author": {
    "name": "Scott Evans",
    "url": "https://scott.ee",
    "email": "git@scott.ee"
  },
  "license": "MIT",
  "dependencies": {
    "@11ty/eleventy": "3.1.6",
    "@11ty/eleventy-fetch": "^5.1.3",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@11ty/gray-matter": "^3.0.0",
    "@11ty/import": "^2.0.1",
    "@apleasantview/eleventy-plugin-baseline": "0.1.0-next.45",
    "@frontmatter/extensibility": "^0.0.18",
    "@inquirer/prompts": "^8.6.0",
    "@minify-html/node": "^0.18.1",
    "alpinejs": "^3.16.2",
    "browserslist": "^4.28.8",
    "cheerio": "^1.2.0",
    "dot-prop": "^10.2.0",
    "eleventy-plugin-embed-everything": "^1.21.2",
    "js-yaml": "^4.3.2",
    "lightningcss": "^1.33.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-image-figures": "^2.1.1",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-table-of-contents": "^1.2.0",
    "mime-types": "^3.0.2",
    "nunjucks": "^3.2.4",
    "playwright": "^1.61.1",
    "terser": "^5.49.0",
    "yoctocolors": "^2.2.0"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "esbuild@0.28.1": true
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3"
  }
}

---
eleventyComputed:
  permalink: "{{ ('/' + lang + '/feed/blogroll.xml') | defaultlocaleurl }}"
eleventyExcludeFromCollections: true
seo:
  excludeFromSitemap: true
---
<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
    <head>
        <title>{{ 'meta.blogrollTitle' | translate }} {{ _elva.meta.separator }} {{ 'meta.title' | translate }}</title>
        <ownerName>{{ _elva.author.name }}</ownerName>
        <ownerEmail>{{ _elva.author.email }}</ownerEmail>
        <ownerId>{{ settings.url }}</ownerId>
        <dateCreated>{{ page.date | dateToRfc822 }}</dateCreated>
    </head>
    <body>
        {% for site in blogroll -%}
        <outline text="{{ site.name }}" title="{{ site.name }}" type="rss" xmlUrl="{{ site.feed }}" htmlUrl="{{ site.url }}"/>
        {% endfor -%}
    </body>
</opml>
---
eleventyComputed:
  permalink: "{{ ('/' + lang + '/feed/' + feedSlug + '.xml') | defaultlocaleurl }}"
eleventyExcludeFromCollections: true
seo:
  excludeFromSitemap: true
---
<?xml version="1.0" encoding="utf-8"?>
<?xml-stylesheet href="{{ ('/' + lang + '/feed/feed.xsl') | defaultlocaleurl | htmlBaseUrl(settings.url) }}" type="text/xsl"?>
<feed xmlns="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/" xml:base="{{ "/" | htmlBaseUrl(settings.url) }}">
    <title>{{ label }} {{ _elva.meta.separator }} {{ 'meta.rssTitle' | translate }} {{ _elva.meta.separator }} {{ 'meta.title' | translate }}</title>
    <subtitle>{{ 'meta.description' | translate }}</subtitle>
	<icon>{{ "/assets/img/icon-512.png" | htmlBaseUrl(settings.url) | cdnify }}</icon>
    <link href="{{ permalink | htmlBaseUrl(settings.url) }}" rel="self"/>
    <link href="{{ "/" | htmlBaseUrl(settings.url) }}" />	
	<updated>{{ collections[collectionTag] | getNewestCollectionItemDate | dateToRfc3339 }}</updated>
	<id>{{ "/" | htmlBaseUrl(settings.url) }}</id>
	<author>
		<name>{{ _elva.author.name }}</name>
		<email>{{ _elva.author.email }}</email>
	</author>
  	{%- for post in collections[collectionTag] | reverse %}
  	{# htmlBaseUrl, not the RSS plugin's absoluteUrl: the two look interchangeable and are not.
  	   absoluteUrl joins an origin; htmlBaseUrl joins an origin *and* applies pathPrefix. Under a
  	   subpath every entry <link> and <id> was one segment short while <content> and <enclosure>
  	   in this same file were correct, because those already use the HtmlBase filters. #}
  	{%- set absolutePostUrl = post.url | htmlBaseUrl(settings.url) %}
	{%- set image = (post.data.thumbnail or _elva.meta.opengraphDefaultImage) | htmlBaseUrl(settings.url) | cdnify %}
	<entry>
		<title>{{ post.data.title }}</title>
		<link href="{{ absolutePostUrl }}" />
		<updated>{{ post.date | dateToRfc3339 }}</updated>
		<id>{{ absolutePostUrl }}</id>
		<content xml:lang="{{ post.lang }}" type="html">{{ post.templateContent | renderTransforms | transformWithHtmlBase(settings.url) }}</content>
		<enclosure url="{{ image | cdnify }}" length="0" type="{{ image | mimetype }}" />
		{%- for tag in post.data.tags | filterprivatetags %}
		<category term="{{ tag }}" />
		{%- endfor %}
	</entry>
	{%- endfor %}
</feed>
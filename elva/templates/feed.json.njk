---
eleventyComputed:
  permalink: "{{ ('/' + lang + '/feed/' + feedSlug + '.json') | defaultlocaleurl }}"
eleventyExcludeFromCollections: true
seo:
  excludeFromSitemap: true
---
{
    "version": "https://jsonfeed.org/version/1.1",
    "title": "{{ label }} {{ _elva.meta.separator }} {{ 'meta.jsonTitle' | translate }} {{ _elva.meta.separator }} {{ 'meta.title' | translate }}",
    "description": "{{ 'meta.description' | translate }}",
    "language": "{{ page.lang }}",
    "home_page_url": "{{ "/" | htmlBaseUrl(settings.url) }}",
    "feed_url": "{{ permalink | htmlBaseUrl(settings.url) }}",
    "icon": "{{ "/assets/img/icon-512.png" | htmlBaseUrl(settings.url) | cdnify }}",
    "favicon": "{{ "/assets/img/icon-180.png" | htmlBaseUrl(settings.url) | cdnify }}",
    "authors": [
        {
            "name": "{{ _elva.author.name }}",
            "url": "{{ _elva.author.url }}"
        }
    ],
    "items": [
        {%- for post in collections[collectionTag] | reverse %}
        {%- set absolutePostUrl = post.url | htmlBaseUrl(settings.url) %}
        {%- set image = (post.data.thumbnail or _elva.meta.opengraphDefaultImage) | htmlBaseUrl(settings.url) | cdnify %}
        {
            "id": "{{ absolutePostUrl }}",
            "url": "{{ absolutePostUrl }}",
            "title": "{{ post.data.title }}",
            "image": "{{ image | cdnify }}",
            {# transformWithHtmlBase, not htmlToAbsoluteUrls — same distinction as the entry URLs
               above, applied to a block of HTML instead of one link. feed.xml.njk already uses it
               for <content>; this is the JSON half of the same feed and was the odd one out. #}
            "content_html": {% if post.templateContent %}{{ post.templateContent | renderTransforms | transformWithHtmlBase(settings.url) | dump | safe }}{% else %}""{% endif %},
            "date_published": "{{ post.date | dateToRfc3339 }}",
            "language": "{{ post.lang }}",
            "tags": [{% set comma = joiner(",") %}{% for tag in post.data.tags | filterprivatetags %}{{ comma() }}"{{ tag }}"{% endfor %}]
        }
        {%- if not loop.last %},{% endif %}
        {%- endfor %}
    ]
}
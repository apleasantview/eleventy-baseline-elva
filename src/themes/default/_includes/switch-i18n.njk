<div class="switch-language">
	{% for lang, properties in settings.languages | dictsort %}
		{% if page.lang === lang %}
			<a
				href="{{ page.url }}"
				lang="{{ page.lang }}"
				hreflang="{{ page.lang }}"
				aria-label="{{ properties.shorthand }}: {{ properties.languageName }}"
				aria-current="page"
				data-tooltip="{{ properties.languageName }}"
				class="current tooltip"
			>
				{{ properties.shorthand }}
			</a>
		{% else %}
			{% set found = false %}

			{# Siblings come from translationKey, not from URL shape, so paginated
			   pages need no fixing up. #}
			{% for link in page.translations %}
				{% if lang === link.lang %}{% set found = link %}{% endif %}
			{% endfor %}

			{% if found %}
				<a
					href="{{ found.url }}"
					lang="{{ found.lang }}"
					hreflang="{{ found.lang }}"
					aria-label="{{ properties.shorthand }}: {{ properties.languageName }}"
					data-tooltip="{{ properties.languageName }}"
					class="tooltip"
				>
					{{ properties.shorthand }}
				</a>
			{% else %}
				<span
					aria-label="{{ properties.shorthand }}: {{ properties.languageName }}"
					data-tooltip="{{ properties.languageName }}"
					class="disabled tooltip"
				>
					{{ properties.shorthand }}
				</span>
			{% endif %}
		{% endif %}
	{% endfor %}
</div>

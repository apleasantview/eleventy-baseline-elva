<!DOCTYPE html>
<html lang="{{ locales[page.lang].locale or page.lang }}" dir="{{ locales[page.lang].dir or 'ltr' }}" x-data :data-theme="$store.elva.theme">
    <baseline-head></baseline-head>
    {# `t`and `u` are gone with the tags that consumed them: Baseline composes the title
       (head.titleSeparator + per-page titleTemplate), the description, the canonical and the
       hreflang set. What remains below is the half Baseline emits nothing for. #}
    {%- set d = (seo.description | striptags | truncate(140, false, '…')) or ('meta.description' | translate) %}
    {%- set i = (thumbnail or _elva.meta.opengraphDefaultImage) | htmlBaseUrl(settings.url) %}
    {%- set ia = thumbnailDescription or ('meta.opengraphDefaultAlt' | translate) %}
    {%- set ta = tags or [] %}

    <!-- charset / viewport -->
    <meta name="text-scale" content="scale">

    <!-- title / description -->
    <meta name="description" content="{{ d }}">

    <!-- open graph: only what Baseline does not emit. -->
    <meta property="og:description" content="{{ d }}">
    <meta property="og:logo" content="{{ "/assets/img/icon-192.png" | htmlBaseUrl(settings.url) | cdnify }}">
    <meta property="og:image" content="{{ i | cdnify }}">
    <meta property="og:image:alt" content="{{ ia }}">

    <!-- icons -->
    <link rel="icon" href="{{ "/favicon.ico" | htmlBaseUrl(settings.url) }}" sizes="any">
    <link rel="icon" href="{{ "/assets/img/icon.svg" | htmlBaseUrl(settings.url) }}" type="image/svg+xml">
    <link rel="apple-touch-icon" href="{{ "/assets/img/icon-180.png" | htmlBaseUrl(settings.url) | cdnify }}">

    <!-- styles -->
    {% set cssInlineBundlePath = _baseline.paths.assets ~ 'css/inline-bundle.css' %}
    {{ cssInlineBundlePath | inlinePostCSS | safe }}

    <!-- feeds -->
    {%- for collectionName, config in types %}
    {%- if config.feed %}
    {%- set feedSlug = 'feed' if collectionName == 'posts' else collectionName %}
    <link rel="alternate" href="{{ ('/feed/' + feedSlug + '.xml') | locale_url | htmlBaseUrl(settings.url) }}" type="application/atom+xml" title="{{ config.label }} {{ _elva.meta.separator }} {{ 'meta.rssTitle' | translate }} {{ _elva.meta.separator }} {{ 'meta.title' | translate }}">
    <link rel="alternate" href="{{ ('/feed/' + feedSlug + '.json') | locale_url | htmlBaseUrl(settings.url) }}" type="application/json" title="{{ config.label }} {{ _elva.meta.separator }} {{ 'meta.jsonTitle' | translate }} {{ _elva.meta.separator }} {{ 'meta.title' | translate }}">
    {%- endif %}
    {%- endfor %}
    {% if blogroll | length %}<link rel="blogroll"  href="{{ "/feed/blogroll.xml" | locale_url | htmlBaseUrl(settings.url) }}" type="text/xml" title="{{ 'meta.blogrollTitle' | translate }} {{ _elva.meta.separator }} {{ 'meta.title' | translate }}">{% endif %}

    <!-- preload / prefetch -->
    {% if (_elva.isProduction or _elva.isStaging) and _elva.cdn %}<link rel="dns-prefetch" href="https://i0.wp.com/">{% endif %}

    <!-- everything else -->
    <meta name="generator" content="{{ eleventy.generator }}">
    <link rel="manifest" href="{{ "/site.webmanifest" | locale_url | htmlBaseUrl(settings.url) }}">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="{{ _elva.themeColorLight }}">
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="{{ _elva.themeColorDark }}">
    {% if _elva.isStaging or seo.noIndex %}<meta name="robots" content="noindex, nofollow">{% endif %}
    {% if _elva.author.githubProfile %}<link rel="me" href="{{ _elva.author.githubProfile }}">{% endif %}
    {% if _elva.author.fediverseProfile %}<link rel="me" href="{{ _elva.author.fediverseProfile }}">{% endif %}
    {% if _elva.author.fediverseUsername %}<meta name="fediverse:creator" content="{{ _elva.author.fediverseUsername }}">{% endif %}

    <!-- set theme before page renders to stop fouc -->
    <!-- inline scripts -->

    <body class="{% set space = joiner(" ") -%}{% for tag in ta -%}{{ space() }}{{ tag | slugify }}{% endfor -%}">
        <!-- header -->
        {% include "header.njk" %}

        <!-- content -->
        <main id="content">{{ content | safe }}</main>

        <!-- footer -->
        {% include "footer.njk" %}

        <!-- scripts: declared in settings.head.script, emitted by <baseline-head> -->
    </body>
</html>
